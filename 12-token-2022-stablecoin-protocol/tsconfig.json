{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "scripts",
    "outDir": "dist",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["scripts/**/*.ts"]
}
